# ===============================================================
# THANDER AI - Atmospheric Intelligence Platform
# Environment Configuration Template (.env.example)
# ===============================================================

# --- Frontend Application Settings ---
NODE_ENV=development
PORT=3000
VITE_API_URL=http://localhost:8000

# --- Backend Core API Settings ---
API_PORT=8000
API_HOST=0.0.0.0
MODEL_VERSION=baseline-v1
DEMO_MODE=false

# --- Google OAuth 2.0 Credentials (Section 6 & 59) ---
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# --- Primary Weather Provider (Open-Meteo) ---
# Open-Meteo is open/free and requires no API key by default.
# If using a commercial Open-Meteo enterprise tier:
WEATHER_API_KEY=

# --- Geospatial & Basemap Provider ---
# Compatible with CartoDB, OpenStreetMap, or MapLibre tiles.
MAP_API_KEY=

# --- Geocoding & Reverse Geocoding ---
# OpenStreetMap Nominatim is used with rate-limiting and local caching.
GEOCODING_USER_AGENT=THANDER-AI-Atmospheric-Command/2.4

# --- Database (PostgreSQL / PostGIS) ---
DATABASE_URL=postgresql://thander:secretpassword@localhost:5432/thander_db

# --- Secondary Observational Feeds (Optional Enterprise Connectors) ---
IMD_RADAR_API_KEY=
INSAT_SATELLITE_KEY=
WWLLN_LIGHTNING_SECRET=
